# Copy to .env only on the cloud host. Do not commit .env.
# Do not put cookie files, AUTH_TOKEN values, or API keys in git.
#
# AUTH_TOKEN is optional. Leave it unset while MCP listens on 127.0.0.1 only.
# If you set it, export it in the process environment. Never commit the value.
# AUTH_TOKEN=
#
# scripts/start_mcp.sh overrides COOKIES_PATH to runtime/session/cookies.json.
XHS_MCP_BASE_URL=http://127.0.0.1:18060
TZ=Asia/Shanghai
