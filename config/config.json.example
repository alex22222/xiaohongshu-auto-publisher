{
  "version": "3.0",
  "description": "小红书自动发布系统配置",
  
  "data_sources": {
    "ruijin": {
      "name": "瑞金医院",
      "file": "/path/to/瑞金医院公众号保健文章汇总.xlsx",
      "image_prefix": "xiaohongshu_",
      "hospital_names": ["瑞金医院"],
      "image_dir": "/path/to/images"
    },
    "zhongliu": {
      "name": "上海肿瘤医院",
      "file": "/path/to/上海肿瘤医院公众号保健文章汇总.xlsx",
      "image_prefix": "zhongliu_",
      "hospital_names": ["复旦肿瘤医院", "复旦大学附属肿瘤医院"],
      "image_dir": "/path/to/images"
    },
    "yunying": {
      "name": "小红书运营材料",
      "file": "/path/to/保健文章汇总.xlsx",
      "image_prefix": "",
      "hospital_names": [],
      "image_dir": "/path/to/小红书运营材料"
    }
  },
  
  "mcp": {
    "base_url": "http://localhost:18060",
    "cookies_path": "~/.xhs-mcp/cookies.json",
    "binary_path": "./mcp/xiaohongshu-mcp-darwin-amd64"
  },
  
  "schedule": {
    "enabled": true,
    "hours": [8, 14, 20],
    "random_delay": true,
    "max_delay_minutes": 60
  },
  
  "content": {
    "max_length": 900,
    "tags": ["健康科普", "健康管理"],
    "remove_hospital_names": true
  },
  
  "notification": {
    "enabled": false,
    "dingtalk_webhook": "",
    "feishu_webhook": ""
  }
}
